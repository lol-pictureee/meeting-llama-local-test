# ============================================================
# Meeting Summarizer — Local AI Environment
# Скопируйте в .env и настройте под себя.
# ============================================================

# --- Go Backend (port 8080) ---
GO_BACKEND_PORT=8080
GO_DB_PATH=/data/meetings.db
GO_UPLOADS_DIR=/data/uploads
GO_EXPORTS_DIR=/data/exports

# --- Whisper Python Service (port 8081) ---
WHISPER_HOST=whisper-service
WHISPER_PORT=8081
WHISPER_MODEL=base

# --- Ollama / Gemma ---
OLLAMA_HOST=ollama-service
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma4:12b

# --- Limits ---
MAX_UPLOAD_SIZE_MB=200
AUDIO_TIMEOUT_SECONDS=600
ANALYSIS_TIMEOUT_SECONDS=300

# --- CPU mode for faster-whisper (true = CPU only) ---
WHISPER_CPU_MODE=true
