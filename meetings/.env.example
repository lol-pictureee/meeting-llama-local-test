# ============================================================
# Meeting Summarizer — Local AI Environment
# Копия шаблона: cp .env.example .env
# Все модели работают локально. Ключей и внешних API нет.
# ============================================================

# --- Go Backend (веб-интерфейс) ---
GO_BACKEND_PORT=8080
GO_DB_PATH=/data/meetings.db
GO_UPLOADS_DIR=/data/uploads
GO_EXPORTS_DIR=/data/exports

# --- Whisper Python Service (внутри Docker-сети) ---
WHISPER_HOST=whisper-service
WHISPER_PORT=8081
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# true = только CPU (без GPU)
WHISPER_CPU_MODE=true
# int8 быстрее на CPU, float32 точнее
WHISPER_COMPUTE_TYPE=int8
# пусто = автоопределение языка, иначе например "ru"
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5

# --- Ollama внутри Docker ---
# Внутренний порт в сети Docker (менять не нужно)
OLLAMA_PORT=11434
# Порт на хосте: локальный Ollama занимает 11434, поэтому по умолчанию 11435
OLLAMA_HOST_PORT=11435
OLLAMA_MODEL=gemma4:12b

# --- Лимиты и таймауты (секунды) ---
MAX_UPLOAD_SIZE_MB=200
AUDIO_TIMEOUT_SECONDS=1800
ANALYSIS_TIMEOUT_SECONDS=900